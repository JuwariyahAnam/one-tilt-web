# Copy to .env for `npm start` (local). Everything is optional.
# API_KEY=choose-a-long-random-string
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# AWS_PROFILE=default            # lets local runs call Bedrock / SNS / DynamoDB (after `npm install`)
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# HELP_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:OneTilt
# SETTINGS_TABLE=OneTiltSettings
# PORT=8787
